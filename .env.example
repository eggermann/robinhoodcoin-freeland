# ── Solana ──────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com # Purpose: configure solana rpc url. Default: https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=./keys/deployer.json # Purpose: configure solana keypair path. Default: ./keys/deployer.json

# ── RobinHoodCoin Token ────────────────────────────────
RHC_TOKEN_NAME=RobinHoodCoin # Purpose: configure rhc token name. Default: RobinHoodCoin
RHC_TOKEN_SYMBOL=RHC # Purpose: configure rhc token symbol. Default: RHC
RHC_TOKEN_DECIMALS=9 # Purpose: configure rhc token decimals. Default: 9
RHC_TOTAL_SUPPLY=1000000000 # Purpose: configure rhc total supply. Default: 1000000000
RHC_MINT_ADDRESS= # Purpose: configure rhc mint address. Default: empty
RHC_MINT_AUTHORITY= # Purpose: configure rhc mint authority. Default: empty

# ── Freeland Stamp NFT ─────────────────────────────────
NFT_COLLECTION_NAME=Freeland Stamps # Purpose: configure nft collection name. Default: Freeland Stamps
NFT_COLLECTION_SYMBOL=FSTAMP # Purpose: configure nft collection symbol. Default: FSTAMP
NFT_BASE_URI=https://robinhoodcoin.org/api/metadata/ # Purpose: configure nft base uri. Default: https://robinhoodcoin.org/api/metadata/
NFT_COLLECTION_ADDRESS= # Purpose: configure nft collection address. Default: empty

# ── Telegram Bot ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here # Purpose: configure telegram bot token. Default: your-telegram-bot-token-here
BOT_ADMIN_IDS=123456789,987654321 # Purpose: configure bot admin ids. Default: 123456789,987654321
BOT_CHAT_AI_ENABLED=true # Purpose: configure bot chat ai enabled. Default: true
BOT_LEADER_LOCK_MODE=none # Purpose: configure bot leader lock mode. Default: none
BOT_LEADER_LOCK_FILE=./data/bot/leader.lock # Purpose: configure bot leader lock file. Default: ./data/bot/leader.lock
BOT_LEADER_LOCK_TTL_MS=60000 # Purpose: configure bot leader lock ttl ms. Default: 60000
BOT_LEADER_LOCK_HEARTBEAT_MS=15000 # Purpose: configure bot leader lock heartbeat ms. Default: 15000
BOT_LEADER_LOCK_RETRY_WAIT_MS=5000 # Purpose: configure bot leader lock retry wait ms. Default: 5000
BOT_TELEGRAM_CONFLICT_RETRY_ATTEMPTS=5 # Purpose: configure telegram polling conflict retries. Default: 5
BOT_TELEGRAM_CONFLICT_RETRY_DELAY_MS=2500 # Purpose: configure telegram polling conflict retry delay ms. Default: 2500

# ── Bot Memory (file-based recall) ─────────────────────
# Purpose: enable/disable persistent memory for chat context.
# Default if unset: true
BOT_MEMORY_ENABLED=true # Purpose: configure bot memory enabled. Default: true
# Purpose: directory used to store memory files.
# Default if unset: ./data/memory
BOT_MEMORY_DIR=./data/memory # Purpose: configure bot memory dir. Default: ./data/memory
# Purpose: max number of recall hits injected into prompts.
# Default if unset: 8
BOT_MEMORY_MAX_RECALL_RESULTS=8 # Purpose: configure bot memory max recall results. Default: 8
# Purpose: number of recent facts prioritized in responses.
# Default if unset: 4
BOT_MEMORY_RECENT_FACTS_COUNT=4 # Purpose: configure bot memory recent facts count. Default: 4
# Purpose: cap entries per memory scope to bound growth.
# Default if unset: 500
BOT_MEMORY_MAX_ENTRIES_PER_SCOPE=500 # Purpose: configure bot memory max entries per scope. Default: 500
# Purpose: optional runtime host label shown in status/debug output.
# Default if unset: unknown-host (usually provided by OS/container)
HOSTNAME=unknown-host # Purpose: optional runtime host label shown in status/debug output. Default: unknown-host

# ── AI Provider ────────────────────────────────────────
# Options: anthropic | openai | openclaw
AI_PROVIDER=anthropic # Purpose: configure ai provider. Default: anthropic
AI_API_KEY=your-api-key-here # Purpose: configure ai api key. Default: your-api-key-here
AI_MODEL=claude-sonnet-4-20250514 # Purpose: configure ai model. Default: claude-sonnet-4-20250514

# ── OpenClaw Gateway (for AI_PROVIDER=openclaw) ────────
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789 # Purpose: configure openclaw gateway url. Default: http://127.0.0.1:18789
# Use one of these depending on gateway auth mode
OPENCLAW_GATEWAY_TOKEN= # Purpose: configure openclaw gateway token. Default: empty
OPENCLAW_GATEWAY_PASSWORD= # Purpose: configure openclaw gateway password. Default: empty
OPENCLAW_AGENT_ID=main # Purpose: configure openclaw agent id. Default: main
OPENCLAW_ENABLE_ROLE_ROUTING=true # Purpose: configure openclaw enable role routing. Default: true
OPENCLAW_DEBUG_ROUTING=false # Purpose: configure openclaw debug routing. Default: false
OPENCLAW_AGENT_SOUL_ID=main # Purpose: configure openclaw agent soul id. Default: main
OPENCLAW_AGENT_FINANCE_ID=finance # Purpose: configure openclaw agent finance id. Default: finance
OPENCLAW_AGENT_LAND_SCOUT_ID=land-scout # Purpose: configure openclaw agent land scout id. Default: land-scout
OPENCLAW_AGENT_PR_ID=pr # Purpose: configure openclaw agent pr id. Default: pr
OPENCLAW_AGENT_MODERATOR_ID=moderator # Purpose: configure openclaw agent moderator id. Default: moderator
OPENCLAW_AGENT_GOVERNANCE_ID=governance # Purpose: configure openclaw agent governance id. Default: governance
OPENCLAW_MODEL=openclaw # Purpose: configure openclaw model. Default: openclaw
OPENCLAW_CHAT_COMPLETIONS_PATH=/v1/chat/completions # Purpose: configure openclaw chat completions path. Default: /v1/chat/completions
OPENCLAW_TIMEOUT_MS=60000 # Purpose: configure openclaw timeout ms. Default: 60000
# Quick profile for chat + autonomous campaign runtime.
# When true, it forces:
# - AI_PROVIDER=openclaw
# - BOT_CHAT_AI_ENABLED=true
# - OPENCLAW_EXPERIENCE_ENABLED=true
# - OPENCLAW_EXPERIENCE_EXCLUSIVE=true
# - OPENCLAW_FUSION_ENABLED=true
OPENCLAW_CAMPAIGN_MODE=false # Purpose: configure openclaw campaign mode. Default: false
OPENCLAW_AUTONOMOUS_ENABLED=false # Purpose: configure openclaw autonomous enabled. Default: false
OPENCLAW_AUTONOMOUS_RUN_ON_BOOT=true # Purpose: configure openclaw autonomous run on boot. Default: true
OPENCLAW_AUTONOMOUS_INTERVAL_MS=900000 # Purpose: configure openclaw autonomous interval ms. Default: 900000
OPENCLAW_AUTONOMOUS_ROLES=governance,pr,moderator # Purpose: configure openclaw autonomous roles. Default: governance,pr,moderator
OPENCLAW_AUTONOMOUS_NOTIFY_CHAT_ID= # Purpose: configure openclaw autonomous notify chat id. Default: empty
OPENCLAW_AUTONOMOUS_MAX_TOKENS=900 # Purpose: configure openclaw autonomous max tokens. Default: 900
OPENCLAW_AUTONOMOUS_TEMPERATURE=0.2 # Purpose: configure openclaw autonomous temperature. Default: 0.2
OPENCLAW_FUSION_ENABLED=true # Purpose: configure openclaw fusion enabled. Default: true
OPENCLAW_FUSION_MAX_ACTIONS=3 # Purpose: configure openclaw fusion max actions. Default: 3
OPENCLAW_FUSION_MAX_TOKENS=1000 # Purpose: configure openclaw fusion max tokens. Default: 1000
OPENCLAW_FUSION_TEMPERATURE=0.1 # Purpose: configure openclaw fusion temperature. Default: 0.1
OPENCLAW_EXPERIENCE_ENABLED=false # Purpose: configure openclaw experience enabled. Default: false
OPENCLAW_EXPERIENCE_RUN_ON_BOOT=true # Purpose: configure openclaw experience run on boot. Default: true
OPENCLAW_EXPERIENCE_INTERVAL_MS=1800000 # Purpose: configure openclaw experience interval ms. Default: 1800000
OPENCLAW_EXPERIENCE_NOTIFY_CHAT_ID= # Purpose: configure openclaw experience notify chat id. Default: empty
OPENCLAW_EXPERIENCE_NOTIFY_ON_NO_ALERT=false # Purpose: configure openclaw experience notify on no alert. Default: false
OPENCLAW_EXPERIENCE_EXCLUSIVE=true # Purpose: configure openclaw experience exclusive. Default: true

# ── Autonomous Land Scout Loop ─────────────────────────
LAND_SCOUT_AUTONOMOUS_ENABLED=false # Purpose: configure land scout autonomous enabled. Default: false
LAND_SCOUT_AUTONOMOUS_RUN_ON_BOOT=true # Purpose: configure land scout autonomous run on boot. Default: true
LAND_SCOUT_AUTONOMOUS_INTERVAL_MS=3600000 # Purpose: configure land scout autonomous interval ms. Default: 3600000
LAND_SCOUT_AUTONOMOUS_MAX_CANDIDATES=5 # Purpose: configure land scout autonomous max candidates. Default: 5
LAND_SCOUT_AUTONOMOUS_SHORTLIST_MIN_SCORE=72 # Purpose: configure land scout autonomous shortlist min score. Default: 72
LAND_SCOUT_VERIFY_SOURCE_REACHABILITY=true # Purpose: configure land scout verify source reachability. Default: true
LAND_SCOUT_SOURCE_TIMEOUT_MS=5000 # Purpose: configure land scout source timeout ms. Default: 5000
LAND_SCOUT_NOTIFY_CHAT_ID= # Purpose: configure land scout notify chat id. Default: empty
LAND_SCOUT_REGION_HINT= # Purpose: configure land scout region hint. Default: empty

# ── Autonomous Finance Monitor Loop ─────────────────────
FINANCE_MONITOR_ENABLED=false # Purpose: configure finance monitor enabled. Default: false
FINANCE_MONITOR_RUN_ON_BOOT=true # Purpose: configure finance monitor run on boot. Default: true
FINANCE_MONITOR_INTERVAL_MS=300000 # Purpose: configure finance monitor interval ms. Default: 300000
FINANCE_MONITOR_MIN_BALANCE_SOL_ALERT=5 # Purpose: configure finance monitor min balance sol alert. Default: 5
FINANCE_MONITOR_LARGE_OUTFLOW_SOL_ALERT=25 # Purpose: configure finance monitor large outflow sol alert. Default: 25
FINANCE_MONITOR_LARGE_INFLOW_SOL_ALERT=25 # Purpose: configure finance monitor large inflow sol alert. Default: 25
FINANCE_MONITOR_NOTIFY_CHAT_ID= # Purpose: configure finance monitor notify chat id. Default: empty
FINANCE_MONITOR_NOTIFY_ON_NO_ALERT=false # Purpose: configure finance monitor notify on no alert. Default: false

# ── Autonomous Execution Policy (headless actions) ─────
AUTONOMY_EXECUTOR_ENABLED=true # Purpose: configure autonomy executor enabled. Default: true
AUTONOMY_EXECUTOR_AUTO_ACTIVATE_PROPOSALS=true # Purpose: configure autonomy executor auto activate proposals. Default: true
AUTONOMY_EXECUTOR_VOTING_WINDOW_HOURS=168 # Purpose: configure autonomy executor voting window hours. Default: 168
AUTONOMY_EXECUTOR_OPPORTUNITY_MIN_SCORE=80 # Purpose: configure autonomy executor opportunity min score. Default: 80
AUTONOMY_EXECUTOR_OPPORTUNITY_MAX_PER_CYCLE=2 # Purpose: configure autonomy executor opportunity max per cycle. Default: 2
AUTONOMY_EXECUTOR_LAND_MIN_SCORE=82 # Purpose: configure autonomy executor land min score. Default: 82
AUTONOMY_EXECUTOR_LAND_MAX_PER_CYCLE=1 # Purpose: configure autonomy executor land max per cycle. Default: 1
AUTONOMY_EXECUTOR_MONTHLY_REPORT=true # Purpose: configure autonomy executor monthly report. Default: true
AUTONOMY_EXECUTOR_MAX_STATE_ENTRIES=2000 # Purpose: configure autonomy executor max state entries. Default: 2000

# ── Standalone OpenClaw Daemon (fully autonomous) ──────
OPENCLAW_DAEMON_ENABLED=false # Purpose: configure openclaw daemon enabled. Default: false
OPENCLAW_DAEMON_RUN_ON_BOOT=true # Purpose: configure openclaw daemon run on boot. Default: true
OPENCLAW_DAEMON_INTERVAL_MS=1800000 # Purpose: configure openclaw daemon interval ms. Default: 1800000
OPENCLAW_DAEMON_ONCE=false # Purpose: configure openclaw daemon once. Default: false
OPENCLAW_DAEMON_NOTIFY_CHAT_ID= # Purpose: configure openclaw daemon notify chat id. Default: empty
OPENCLAW_DAEMON_NOTIFY_ON_NO_ALERT=false # Purpose: configure openclaw daemon notify on no alert. Default: false

# ── Treasury ───────────────────────────────────────────
TREASURY_MULTISIG_ADDRESS= # Purpose: configure treasury multisig address. Default: empty

# ── Operations / PayPal (Secret) ───────────────────────
# Must be set for bot startup; never hardcode in source.
PAYPAL_RECEIVER=your-paypal-email-here # Purpose: configure paypal receiver. Default: your-paypal-email-here
OPERATIONS_PAYPAL_SHARE=0.4 # Purpose: configure operations paypal share. Default: 0.4
