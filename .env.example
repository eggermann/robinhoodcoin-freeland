# ── Solana ──────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=./keys/deployer.json

# ── RobinHoodCoin Token ────────────────────────────────
RHC_TOKEN_NAME=RobinHoodCoin
RHC_TOKEN_SYMBOL=RHC
RHC_TOKEN_DECIMALS=9
RHC_TOTAL_SUPPLY=1000000000

# ── Freeland Stamp NFT ─────────────────────────────────
NFT_COLLECTION_NAME=Freeland Stamps
NFT_COLLECTION_SYMBOL=FSTAMP
NFT_BASE_URI=https://robinhoodcoin.org/api/metadata/

# ── Telegram Bot ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
BOT_ADMIN_IDS=123456789,987654321

# ── AI Provider ────────────────────────────────────────
# Options: anthropic | openai
AI_PROVIDER=anthropic
AI_API_KEY=your-api-key-here
AI_MODEL=claude-sonnet-4-20250514

# ── Treasury ───────────────────────────────────────────
TREASURY_MULTISIG_ADDRESS=

# ── Operations / PayPal (Secret) ───────────────────────
# Must be set for bot startup; never hardcode in source.
PAYPAL_RECEIVER=your-paypal-email-here
OPERATIONS_PAYPAL_SHARE=0.4
