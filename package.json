{
  "name": "robinhoodcoin-freeland",
  "version": "0.1.0",
  "description": "RobinHoodCoin — A crypto-powered initiative to acquire communal 'freeland' and support Robin Hood-like causes",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run start:bot",
    "dev": "npm run dev:bot",
    "dev:campaign": "OPENCLAW_CAMPAIGN_MODE=true npm run dev:bot",
    "build": "tsc",
    "dev:bot": "tsx watch src/bot/index.ts",
    "dev:autonomy": "tsx watch src/autonomy/openclaw-daemon.ts",
    "start:bot": "node dist/bot/index.js",
    "start:campaign": "OPENCLAW_CAMPAIGN_MODE=true npm run start:bot",
    "start:autonomy": "node dist/autonomy/openclaw-daemon.js",
    "deploy:token": "tsx src/token/deploy.ts",
    "transfer:mint-authority": "tsx src/token/transfer-mint-authority.ts",
    "deploy:nft": "tsx src/nft/deploy.ts",
    "deploy:uberspace": "bash ./deploy_uberspace",
    "deploy_uberspace": "bash ./deploy_uberspace",
    "sync:web-data": "tsx src/site/sync-dashboard.ts",
    "predev:web": "npm run sync:web-data",
    "dev:web": "vite dev --config vite.config.ts",
    "prebuild:web": "npm run sync:web-data",
    "build:web": "vite build --config vite.config.ts",
    "check:openclaw": "bash scripts/raspberrypi/openclaw-local-check.sh",
    "check:env": "bash scripts/raspberrypi/check-env-sanity.sh .env",
    "test:mail": "tsx src/tools/test-mail.ts",
    "start:mail-endpoint": "tsx src/tools/mail-endpoint.ts",
    "notify:project": "tsx src/tools/send-project-update.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-token-metadata": "^3.3.0",
    "@metaplex-foundation/umi": "^0.9.2",
    "@metaplex-foundation/umi-bundle-defaults": "^0.9.2",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "@sqds/multisig": "^2.1.3",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.31.0",
    "nodemailer": "^6.10.1",
    "semantic-stream": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.23",
    "openclaw": "^2026.2.22-2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
